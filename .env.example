# =============================================================================
# Host machine (local pytest, uvicorn on Windows without Docker)
# =============================================================================
DATABASE_URL=postgresql://admin:secret@localhost:5433/marketing_db

# Routing: LiteLLM proxy (docker) → LM Studio on host (:1234).
LITELLM_BASE_URL=http://localhost:4000

# Direct LM Studio OpenAI-compatible base (host Python only).
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# OpenRouter (production LLM backend for the Docker `app` service).
# Required by docker-compose.yml — it fails fast if unset:
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# AGENT_MODEL_DISCOVERY=google/gemma-4-26b-a4b-it:free
# AGENT_MODEL_HEAD=google/gemma-4-26b-a4b-it:free

# Optional on host: route agents through LiteLLM instead of direct LM Studio.
# OPENAI_API_BASE=http://localhost:4000/v1
# OPENAI_API_KEY=dev-key

# Host agent models — exact LM Studio model ids when not using LiteLLM aliases.
AGENT_MODEL_DISCOVERY=mistralai/mistral-7b-instruct-v0.3
AGENT_MODEL_HEAD=mistralai/mistral-7b-instruct-v0.3

# =============================================================================
# Docker `app` service (set automatically in docker-compose.yml environment:)
# Do not copy these into .env unless you run the app container without compose overrides.
# =============================================================================
# DATABASE_URL=postgresql://admin:secret@postgres:5432/marketing_db
# OPENAI_API_BASE=http://litellm:4000/v1
# OPENAI_API_KEY=dev-key
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# AGENT_MODEL_DISCOVERY=discovery-model
# AGENT_MODEL_HEAD=head-model

OLLAMA_BASE_URL=http://localhost:11434

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
APP_PORT=8000
DEBUG=true

# When you enable live integrations, set (examples):
# GMAIL_USER, GMAIL_APP_PASSWORD — email
# WA_PHONE_NUMBER_ID, WA_ACCESS_TOKEN — WhatsApp
# Site DB / API — read-only vs publish credentials (see TECHNICAL_IMPLEMENTATION_TRACKER.md).

# Live integration tests (real DuckDuckGo + LM Studio — no mocks):
# RUN_LIVE_TESTS=1
# LM_VERIFY_MODEL=phi-2
# LM_STUDIO_BASE=http://127.0.0.1:1234

# Docker smoke (inside app container):
# python scripts/real_verification.py --docker-smoke
# python scripts/real_verification.py --docker-smoke --skip-llm   # Phase A only
